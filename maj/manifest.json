,"u":"https://raw.githubusercontent.com/PataphiX-creator/academie-art/main/maj/c-2ace111b55323d4429b569764e62a6302849e0c5.gz","z":7125},"js/saves.js":{"h":"189a581ba81e21c1b06afc5a0ec6fd4de3ab2138985fdd7a117001ccd61d9161","s":4286,"u":"https://raw.githubusercontent.com/PataphiX-creator/academie-art/main/maj/c-189a581ba81e21c1b06afc5a0ec6fd4de3ab2138.gz","z":1745},"js/story.js":{"h":"e97eb631549c8ba0e196bc0be97f6d59d1575e08a886fde05e1f92b78c709950","s":62763,"u":"https://raw.githubusercontent.com/PataphiX-creator/academie-art/main/maj/c-e97eb631549c8ba0e196bc0be97f6d59d1575e08.gz","z":21286},"js/touch.js":{"h":"fcf77cd3995ac7dbfabce607d784a0b6705b881538574938530a79b448c8cb6c","s":18041,"u":"https://raw.githubusercontent.com/PataphiX-creator/academie-art/main/maj/c-fcf77cd3995ac7dbfabce607d784a0b6705b8815.gz","z":6918},"js/ui.js":{"h":"9f71d737706240f5dae54d4e54c95598a448af7f1759332cd92034383dcd3988","s":25041,"u":"https://raw.githubusercontent.com/PataphiX-creator/academie-art/main/maj/c-9f71d737706240f5dae54d4e54c95598a448af7f.gz","z":8587},"js/world.js":{"h":"886234f0be8674232f8a6e8fee5edc8f44fe9f16fd5a448fbe9c4bb4a23794f1","s":26115,"u":"https://raw.githubusercontent.com/PataphiX-creator/academie-art/main/maj/c-886234f0be8674232f8a6e8fee5edc8f44fe9f16.gz","z":8823},"version.json":{"h":"45e073769e27dd4af1268421847f38021f7c84839ac48a8a99597d9c75263abe","s":33,"u":"https://raw.githubusercontent.com/PataphiX-creator/academie-art/main/maj/c-45e073769e27dd4af1268421847f38021f7c8483"}},"launcher":{"build":1},"minLauncher":1,"notes":{"en":"2.0.1: fixes. Textures no longer flicker in the main office, the principal's office, the archives and on the roof. The big notebook no longer goes through the hall ceiling. Bosses whose weak point is their BACK (the sharpener, the notebook…) turn around more slowly. A save star now waits on the roof before the Titan.","es":"2.0.1: correcciones. Las texturas ya no parpadean en la secretaría, el despacho del director, los archivos y el tejado. El gran cuaderno ya no atraviesa el techo del vestíbulo. Los jefes cuyo punto débil es la ESPALDA (el sacapuntas, el cuaderno…) se giran más despacio. Una estrella de guardado espera en el tejado antes del Titán.","fr":"2.0.1 : corrections. Les textures ne scintillent plus dans le secrétariat, le bureau du directeur, les archives et sur le toit. Le grand carnet ne traverse plus le plafond du hall. Les boss dont le point faible est le DOS (le taille-crayon, le carnet…) se retournent moins vite. Une étoile de sauvegarde attend sur le toit avant le Titan.","ja":"2.0.1：修正。事務室・校長室・資料室・屋上でテクスチャがちらつかなくなりました。大きなノートがホールの天井を突き抜けなくなりました。弱点が背中のボス（えんぴつけずり、ノートなど）がゆっくり振り向くようになりました。タイタンの前、屋上にセーブポイントを追加しました。","zh":"2.0.1：修复。秘书处、校长办公室、档案室和屋顶的贴图不再闪烁。巨大的笔记本不再穿过大厅天花板。弱点在背后的首领（卷笔刀、笔记本……）转身变慢了。泰坦之前的屋顶上新增了存档星。"},"version":"2.0.1"}